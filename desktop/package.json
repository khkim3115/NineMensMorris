{
  "name": "nine-mens-morris-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "나인 멘스 모리스 트레이 데스크톱 앱 — 시스템 트레이에 상주하는 Electron 미니 게임",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.khkim.ninemensmorris",
    "productName": "Nine Mens Morris",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "renderer.js",
      "vendor/nmm-engine.js",
      "vendor/supabase.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "NineMensMorris-Tray.dmg",
      "title": "Nine Men's Morris"
    },
    "nsis": {
      "artifactName": "NineMensMorris-Tray-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Nine Men's Morris"
    },
    "publish": {
      "provider": "github",
      "owner": "khkim3115",
      "repo": "NineMensMorris"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
